{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nookdeck plugin registry",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "author", "repo", "version", "sha256", "description", "permissions"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+){2,}$", "not": { "pattern": "^core\\." } },
      "name": { "type": "string", "minLength": 1, "maxLength": 60 },
      "author": { "type": "string", "minLength": 1 },
      "repo": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+(/tree/[^/]+(/.+)?)?$" },
      "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "description": { "type": "string", "minLength": 1, "maxLength": 200 },
      "permissions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "network": { "type": "array", "items": { "type": "string" } },
          "shell": { "type": "boolean" },
          "keyboard": { "type": "boolean" },
          "storage": { "type": "boolean" },
          "onair": { "type": "boolean" },
          "notify": { "type": "boolean" }
        }
      },
      "screenshot": { "type": "string", "pattern": "^https://" },
      "verified": { "type": "boolean" }
    }
  }
}
